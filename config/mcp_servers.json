{
  "servers": [
    {
      "name": "filesystem",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.8.31",
        "${PROJECT_ROOT}"
      ],
      "env": {},
      "required": false,
      "enabled": true
    },
    {
      "name": "fetch",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "env": {},
      "required": false,
      "enabled": true
    },
    {
      "name": "sqlite",
      "command": "${PYTHON}",
      "args": [
        "${PROJECT_ROOT}/servers/sqlite_mcp_server.py",
        "${SQLITE_DB}"
      ],
      "env": {},
      "required": true,
      "enabled": true
    }
  ]
}